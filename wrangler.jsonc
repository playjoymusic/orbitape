// ORBITAPE — Cloudflare dağıtım tarifi
// ─────────────────────────────────────────────────────────────────
// Bu dosya Cloudflare'a "depodaki neyi yayınlayacağını" söylüyor.
// Bağlantı kurulduktan sonra main dalına her push, siteyi otomatik
// güncelliyor. Elle dosya sürüklemek bitiyor.
//
// DERLEME ADIMI YOK. Uygulama tek dosya; ne paketleyici ne dönüştürücü
// var. Cloudflare depoyu alıp olduğu gibi yayınlıyor.
//
// name ALANI KRİTİK: mevcut Worker'ın adıyla birebir aynı olmalı.
// Farklı olursa Cloudflare yeni bir Worker yaratır ve orbitape.app
// eski hâlinde kalır — yani yayın güncellenmez.
{
  "name": "orbitape",
  "compatibility_date": "2026-08-26",

  // Statik dosyalar deponun kökünde. Yayına girmemesi gerekenler
  // .assetsignore dosyasında listeli (testler, araçlar, README).
  //
  // html_handling BİLEREK yazılmadı: varsayılan (auto-trailing-slash)
  // /privacy adresini privacy.html'e eşliyor ve bugün çalışan şey bu.
  //
  // not_found_handling: "404-page"
  //   Eşleşmeyen bir adreste Cloudflare'ın düz beyaz "404 Not Found"
  //   ekranı yerine 404.html gösteriliyor — kullanıcı için geri
  //   dönecek bir kapı. html_handling'i ETKİLEMİYOR: bu kural yalnız
  //   hiçbir dosya eşleşmediğinde devreye giriyor, yani /privacy
  //   eskisi gibi çalışmaya devam ediyor.
  //   (developers.cloudflare.com/workers/static-assets/routing/
  //    static-site-generation/)
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },

  // ── DENEME YAYINI (staging) ─────────────────────────────────────
  // NEDEN VAR: bugune kadar yayina cikan surumu, yayina cikmadan
  // once GORME imkanimiz yoktu. main'e push -> dogrudan orbitape.app.
  // Testler yerelde yesil olsa bile "gercekten yayinlanan dosya" ile
  // "yerelde denenen dosya" ayni oldugunu kimse dogrulamiyordu.
  //
  // Bu blok ayri bir Worker tanimliyor: AYNI dosyalar, BASKA adres.
  //   npx wrangler deploy --env deneme
  //   -> https://orbitape-deneme.<hesabin>.workers.dev
  //
  // orbitape.app'e DOKUNMUYOR: name farkli oldugu icin Cloudflare
  // bunu ayri bir Worker olarak tutuyor, uretim yayini etkilenmiyor.
  // (name alaninin kritik oldugu yukarida yaziyor -- burada da ayni
  // sebeple bilerek FARKLI.)
  //
  // Sira: kontrol.sh yesil -> deneme'ye yayinla -> telefondan ac ->
  // sonra main'e push.
  "env": {
    "deneme": {
      "name": "orbitape-deneme",
      "assets": {
        "directory": "./",
        "not_found_handling": "404-page"
      }
    }
  }
}
