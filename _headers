# ORBITAPE — YAYIN BASLIKLARI
#
# Bu dosya yayina GITMIYOR; Cloudflare onu okuyup kurallarini
# cevaplara uyguluyor.
#
# ── NEDEN ─────────────────────────────────────────────────────────
# Uygulamanin gizlilik sozu "hicbir sey toplamiyoruz" degil sadece;
# "senin hakkinda hicbir sey KIMSEYE soylemiyoruz" da. Referrer-Policy
# olmadan bu soz eksik kaliyordu: tarayici archive.org'a, radyo
# istasyonuna, sarki adi soran uc noktalara her istekte hangi sayfadan geldigini
# soyluyordu. Simdi soylemiyor.
#
# ── CSP NEREDE ────────────────────────────────────────────────────
# Dosyanin SONUNDA, her sayfa icin ayri ayri; oraya araclar/csp.py
# yaziyor. Burada degil, cunku politika ozet (hash) iceriyor ve her
# sayfanin ozeti farkli. Ayrintisi ve bir kez yapilan hatanin kaydi
# csp.py'nin basinda.

/*
  # Tarayici, dosyayi sunucunun soyledigi turden BASKA bir sey
  # sanmasin. MIME tahmini eski ve gercek bir saldiri yoluydu.
  X-Content-Type-Options: nosniff

  # Baska bir site ORBITAPE'i gorunmez bir cerceveye alip kullanicinin
  # farkinda olmadan uzerine tiklatamasin (clickjacking).
  X-Frame-Options: DENY

  # Disariya cikan hicbir istekte "hangi sayfadan geldim" bilgisi
  # gitmesin. Gizlilik metnindeki sozun teknik karsiligi.
  Referrer-Policy: no-referrer

  # Uygulamanin KENDISININ kullandigi tek sey acik (on kamera), geri
  # kalan her sey kapali. Kural basit: istemedigi bir seyin izni de
  # olmamali.
  # display-capture KALKTI: kural kendi kendisiyle celisiyordu.
  # Ekran kaydi getDisplayMedia ILE YAPILMIYOR -- o cagri kodda hic
  # gecmiyor; kayit uygulamanin kendi tuvalinden (captureStream)
  # aliniyor ve hicbir izin istemiyor.
  Permissions-Policy: camera=(self), display-capture=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), serial=(), bluetooth=(), interest-cohort=()

# METIN DOSYALARI UTF-8. Cloudflare .txt ve .xml icin charset
# soylemiyor; tarayici da eski bir kodlama varsayiyor ve dosyadaki
# uzun tire ekranda "â€”" olarak cikiyordu. Yalnizca yorum
# satirlarinda oldugu icin robotlari etkilemiyordu ama dosya yanlis
# gorunuyordu. Kodlamayi acikca soylemek dogrusu.
/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# ── DIGITAL ASSET LINKS ──────────────────────────────────────────
# TWA'nin adres cubugunu gizlemesi bu dosyaya bagli: Chrome uygulamayi
# acarken orbitape.app/.well-known/assetlinks.json'u okuyup imza
# parmak izini karsilastiriyor.
# Content-Type YANLIS olursa Chrome dosyayi OKUMAZ ve dogrulama sessizce
# duser -- uygulama tarayici gibi acilir, adres cubugu gorunur ve
# sebebi hicbir yerde yazmaz. Cloudflare uzantisiz/az bilinen yollarda
# turu tahmin ediyor; burada acikca soyluyoruz.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

# Ikonlar ve ekran goruntuleri surum etiketiyle (?v=6) cagriliyor;
# icerik degisince etiket degisiyor. O yuzden uzun onbellek guvenli
# ve her acilista yeniden indirilmiyorlar.
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/ekran-*.png
  Cache-Control: public, max-age=604800

# ── UYGULAMANIN KENDISI: HER ACILISTA SOR ────────────────────────
# "Kural yazmazsak tarayici zaten sorar" diye dusunulmustu. YANLIS.
# Cache-Control yoksa tarayici SEZGISEL onbellege duser: dosyanin
# yasina bakip kendi kafasina gore bir sure saklar. Olculen sonuc:
# yeni surum yayindayken uygulama ESKI surumu acti (iOS'ta ana
# ekrana eklenmis halde daha da inatci).
# no-cache = "sakla ama KULLANMADAN ONCE SOR". Degismediyse sunucu
# 304 donuyor, yani maliyet neredeyse sifir; degistiyse kullanici
# yeni surumu ILK acilista goruyor.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Servis calisani da ayni sebeple: eski bir sw.js yeni kabugu
# hic gormeyebilir.
/sw.js
  Cache-Control: no-cache

# ── ISTASYON LISTESI ─────────────────────────────────────────────
# Uygulama listeyi artik once BURADAN cekiyor (eskiden GitHub'in raw
# sunucusundan). Cloudflare'da statik dosya istegi ucretsiz ve
# sinirsiz, ustelik kullaniciya en yakin kenardan cikiyor.
# 10 dakika taze, sonrasinda bir gun boyunca "eskisini goster, arkada
# yenile": kullanici hicbir zaman liste yuklenmesini BEKLEMIYOR, ama
# hasat yeni istasyon ekleyince de en gec ertesi acilista goruyor.
# ── BEKLEME PENCERESI KISALDI: 1 GUN -> 1 SAAT ──────────────────
# Olculen sikayet (30 Agustos): "rafi degistirdim, push'ladim, ama
# uygulama hala ESKI listeyi caliyor."
# Sebep buradaydi. stale-while-revalidate=86400, tarayiciya sunu
# soyluyor: "kopya bayatlasa bile BIR GUN boyunca eskisini goster,
# yenisini arkada indir." Yani liste guncellendikten sonra bir
# kullanici (ve gelistirici) bir gun eski listeyi gorebiliyordu.
# Uzun pencere dayaniklilik icin konmustu -- ama o isi zaten
# cihazdaki kendi onbellegimiz yapiyor (onbellekOku, 3 hafta) ve
# yalnizca cekim BASARISIZ olunca devreye giriyor. Yani 1 gunluk
# pencere hicbir sey eklemiyordu, sadece bayatlik uretiyordu.
# 1 saat: acilis yine anlik, ama bir degisiklik en gec bir saat
# icinde herkeste.
/radyo.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# ── ARSIV LISTELERI ──────────────────────────────────────────────
# earth.json (5,4 MB) ve earth_buyuk.json (2,2 MB) de artik burada.
# Once raw.githubusercontent.com'dan geliyorlardi; tracks deposu
# private olunca o adresler kapaniyor ve zaten bizim olmayan iki
# sunucuya bagli olmanin anlami yoktu.
# ISTASYON LISTESINDEN DAHA UZUN TAZE: bu iki dosya haftada bir
# degisiyor (hasat), radyo.json daha sik. 6 saat taze, bir hafta
# "eskisini goster arkada yenile" -- boylece 5 MB'lik dosya her
# acilista degil, gunde bir kez telden geciyor.
/earth.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=21600, stale-while-revalidate=604800

# BASLANGIC DOSYASI: arsivin ilk acilista indirdigi 700 kayit
# (58 KB gzip). Tam havuz arkadan iniyor. Ayni tazelik penceresi --
# ikisi de ayni hasattan cikiyor, biri otekinden taze olamaz.
/earth_giris.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=21600, stale-while-revalidate=604800

/earth_buyuk.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=21600, stale-while-revalidate=604800

