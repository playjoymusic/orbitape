# Yayına GİRMEYECEK dosyalar.
#
# Depo herkese açık, yani buradakiler zaten görünür. Mesele gizlilik
# değil, temizlik ve boyut: test malzemesi 260 KB ve ziyaretçinin
# orbitape.app/test/... altında bunları bulmasının bir anlamı yok.

test/
araclar/
.github/
node_modules/

# ── DEPONUN KENDISI ──────────────────────────────────────────────
# .git YUKLENIYORDU. Ilk kez `wrangler deploy` elle calistirilinca
# gorundu: 1673 dosya okundu ve ciktinin yarisi
# ".git/objects/9b/e8df45..." satirlariydi. Yani deponun butun
# gecmisi yayina cikan dosyalar arasindaydi.
# Depo herkese acik, yani sir kacmiyor; ama yayina cikmasi gereken
# sey UYGULAMA, deponun kendisi degil -- ve bosuna bin dosya.
.git/
.wrangler/
.DS_Store

# Ic belge: erisim listesi ve kurtarma yordami. Depoda dursun,
# yayinda gorunmesin.
KURTARMA.md

# MAGAZA GORSELLERI: Play Console'a elle yuklenen dosyalar, sitenin
# parcasi degil. Depoda duruyorlar (yedek ve gecmis), yayina
# gitmiyorlar: 7 MB'lik ekran goruntusunun orbitape.app/magaza/...
# altinda servis edilmesinin bir anlami yok.
magaza/

README.md
CLAUDE.md
GUNLUK.md
KONTROL.md

# ── CALISMA SAYFALARI ────────────────────────────────────────────
# Bunlar gelistirme sirasinda uretilmis Turkce panolar: yol
# haritasi, rakip analizi, raf revizyonu, olcum tezgahlari. Depoda
# duruyorlar (kayit), yayina gitmiyorlar.
#
# NEDEN ONEMLI: simdicalan.html tek tusla yaklasik 300 istasyon
# sunucusuna istek atan bir olcum tezgahi ve robots.txt "Allow: /"
# diyor. Yayindayken orbitape.app/simdicalan.html adresinden herkese
# acikti. sitemap.xml de "uc sayfa, o kadar" diyor -- bu liste
# olmadan o cumle yalandi.
gun.html
kiyas.html
kiyas_pro.html
raf.html
raf_revizyon.html
simdicalan.html
ucluk_deneme.html
yol.html
zayif.html
package.json
package-lock.json
wrangler.jsonc
.gitignore
.assetsignore

# Hasat ciktilari yanlislikla depoya girerse en azindan YAYINA
# gitmesin: tek dosya siniri 25 MiB ve bu dosya 30 MB.
yeni_hasat.json
hasat_durum.json

# _headers BURAYA YAZILMAZ — bir kere yazildi ve yanlisti.
# Mantik "yayina gitmesin" diye dusundurtuyor ama .assetsignore
# dosyayi HIC YUKLEMIYOR; yuklenmeyen dosyanin kurallari da hic
# uygulanmiyor. Cloudflare _headers'i yukluyor, ayristiriyor ve
# KENDISI servis etmiyor. Yani dogru yer burasi degil.
#   "_headers and _redirects files are supported natively in Workers
#    with static assets. Ensure that ... these files are included in
#    the static asset directory of your project."
#   developers.cloudflare.com/workers/static-assets/migration-guides/
#   migrate-from-pages/

# OLCUM UC NOKTASININ KAYNAGI: Cloudflare bunu Worker olarak
# derliyor (wrangler.jsonc -> main), yani ayrica statik dosya olarak
# servis edilmesinin bir anlami yok. Depoda acik duruyor, yayinda
# /olcu.js diye ikinci bir kopya olmasin.
olcu.js
